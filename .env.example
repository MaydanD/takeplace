# =============================================================================
# Takeplace — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# `bash scripts/bootstrap-env.sh` does this for local development.
# Every value here is environment configuration, never a hardcoded default.
# =============================================================================

# --- Deployment ---
# development | staging | production
TAKEPLACE_ENV=development
# Log level for the backend (DEBUG/INFO/WARNING/ERROR). Use DEBUG only locally.
TAKEPLACE_LOG_LEVEL=INFO

# --- Local ports ---
TAKEPLACE_POSTGRES_PORT=5432
TAKEPLACE_API_PORT=8000
TAKEPLACE_FRONTEND_PORT=5173

# --- PostgreSQL bootstrap (superuser, used only to create the DB and roles) ---
# This role is never used by the application.
TAKEPLACE_POSTGRES_SUPERUSER=takeplace_admin
TAKEPLACE_POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
TAKEPLACE_POSTGRES_DB=takeplace

# --- Application DB roles (created by infra/postgres/init/10-roles.sh) ---
# migrator: owns schema objects and runs DDL/migrations.
TAKEPLACE_DB_MIGRATOR_USER=takeplace_migrator
TAKEPLACE_DB_MIGRATOR_PASSWORD=change-me-migrator
# app: DML only, no CREATE/ALTER/DROP.
TAKEPLACE_DB_APP_USER=takeplace_app
TAKEPLACE_DB_APP_PASSWORD=change-me-app

# --- Database timeouts (milliseconds) ---
# Production baseline from PROJECT-SPEC §32.6. Development raises them so that
# interactive debugging is not killed mid-statement.
TAKEPLACE_DB_STATEMENT_TIMEOUT_MS=10000
TAKEPLACE_DB_LOCK_TIMEOUT_MS=3000
TAKEPLACE_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# Migrations may legitimately run longer than a request.
TAKEPLACE_DB_MIGRATION_STATEMENT_TIMEOUT_MS=300000

# --- Database pool ---
TAKEPLACE_DB_POOL_SIZE=5
TAKEPLACE_DB_MAX_OVERFLOW=5

# --- CORS ---
# Comma-separated exact origins. Never use "*".
TAKEPLACE_CORS_ORIGINS=http://localhost:5173

# --- Proxy trust ---
# Comma-separated IPs/CIDRs whose X-Forwarded-* headers are trusted. Only the
# reverse proxy / internal network should be listed. "*" is rejected in
# production (PROJECT-SPEC §39.5).
TAKEPLACE_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Admin session cookie (PROJECT-SPEC §39.2) ---
# Leave unset for the default: Secure + `__Host-`-prefixed cookie in production,
# relaxed (non-prefixed, no Secure) outside production so browsers accept it on
# plain http://localhost. Setting `false` in production is rejected at startup.
# TAKEPLACE_SESSION_COOKIE_SECURE=false

# --- Sessions / abuse limits (PROJECT-SPEC §6.3, §39) ---
# Absolute session TTL in days (1–30, no sliding renewal).
TAKEPLACE_SESSION_TTL_DAYS=30
# Minimum interval between `last_seen_at` refreshes per session, in seconds.
TAKEPLACE_SESSION_LAST_SEEN_REFRESH_SECONDS=60
# Concurrency cap for the CPU-bound Argon2id pool.
TAKEPLACE_ARGON2_MAX_CONCURRENCY=4

# --- Secrets (generate with `bash scripts/bootstrap-env.sh`) ---
# HMAC key for idempotency payload fingerprints (PROJECT-SPEC §42.1).
TAKEPLACE_IDEMPOTENCY_HMAC_KEY=change-me-idempotency-hmac-key
# HMAC key for short-lived abuse network fingerprints (PROJECT-SPEC §40).
TAKEPLACE_ABUSE_HMAC_KEY=change-me-abuse-hmac-key
# Master key material for VK token encryption (PROJECT-SPEC §38.5).
# Versioned key ring: comma-separated `<version>:<base64url-32-byte-key>` entries.
# The highest key version is used for new encryption; older entries decrypt existing data.
TAKEPLACE_VK_ENCRYPTION_KEYS=1:change-me-32-byte-base64url-key

# --- Realtime (PROJECT-SPEC §37) ---
# SSE heartbeat cadence in seconds; comments only keep the connection warm and
# never trigger a frontend refetch. Production baseline ~20s (§37.4).
TAKEPLACE_REALTIME_HEARTBEAT_SECONDS=20
# Bounded per-connection event queue; overflow closes the stream with a resync.
TAKEPLACE_REALTIME_QUEUE_MAXSIZE=256
# Each API process LISTENs on PostgreSQL. Disable only for tests without a DB.
TAKEPLACE_REALTIME_LISTENER_ENABLED=true
# Upper bound (seconds) on how long a revoked session may keep receiving events.
# The stream revalidates the session on this fixed cadence regardless of traffic.
TAKEPLACE_REALTIME_SESSION_CHECK_SECONDS=30

# --- Frontend ---
# Only used by Vite for local development; in production the API is same-origin.
TAKEPLACE_FRONTEND_API_BASE_URL=

# --- Public booking (PROJECT-SPEC §32.2, §40, §42, §50) ---
# Soft, in-memory, per-process rate limits. Not a security boundary (§40).
# Availability reads are cheaper and tolerate a higher limit than creates.
TAKEPLACE_PUBLIC_AVAILABILITY_RATE_WINDOW_SECONDS=60
TAKEPLACE_PUBLIC_AVAILABILITY_RATE_MAX_REQUESTS=60
TAKEPLACE_PUBLIC_CREATE_RATE_WINDOW_SECONDS=300
TAKEPLACE_PUBLIC_CREATE_RATE_MAX_REQUESTS=10
# CAPTCHA adapter/feature-flag hook (§40, §50). Disabled by default; no external
# provider is wired in v1. Enabling without a provider rejects creates rather
# than silently skipping the check.
TAKEPLACE_PUBLIC_CAPTCHA_ENABLED=false
# Versioned privacy policy the guest consents to on ONLINE create (§42).
TAKEPLACE_PUBLIC_PRIVACY_POLICY_VERSION=1.0.0
# Retention (days) for the short-lived request_ip_hmac abuse fingerprint (§40).
TAKEPLACE_REQUEST_IP_HMAC_TTL_DAYS=7
TAKEPLACE_PUBLIC_CREATE_BURST_WINDOW_SECONDS=10
TAKEPLACE_PUBLIC_CREATE_BURST_MAX_REQUESTS=5
TAKEPLACE_PUBLIC_CREATE_DAY_MAX_REQUESTS=100
# Aggregate ONLINE-create alert, per API process; no automatic kill switch.
TAKEPLACE_PUBLIC_ABUSE_WINDOW_SECONDS=600
TAKEPLACE_PUBLIC_ABUSE_THRESHOLD=50
TAKEPLACE_PUBLIC_ABUSE_COOLDOWN_SECONDS=900

# --- VK transactional outbox / separate worker (PROJECT-SPEC §38) ---
# Venue tokens and destinations are configured in the admin UI, never in env.
TAKEPLACE_VK_WORKER_ENABLED=true
TAKEPLACE_VK_API_VERSION=5.199
TAKEPLACE_VK_HTTP_TIMEOUT_SECONDS=10
TAKEPLACE_VK_NOTIFICATION_MAX_AGE_SECONDS=21600
TAKEPLACE_VK_NOTIFICATION_LATE_GRACE_SECONDS=1800
TAKEPLACE_VK_WORKER_POLL_INTERVAL_SECONDS=2
# Must exceed the HTTP timeout by more than 5 seconds.
TAKEPLACE_VK_WORKER_LEASE_SECONDS=120
TAKEPLACE_VK_WORKER_BATCH_SIZE=10
TAKEPLACE_VK_WORKER_MAX_ATTEMPTS=8
TAKEPLACE_VK_WORKER_RETRY_BASE_SECONDS=30
TAKEPLACE_VK_WORKER_RETRY_MAX_SECONDS=3600
TAKEPLACE_VK_WORKER_THROTTLE_WINDOW_SECONDS=60
TAKEPLACE_VK_WORKER_THROTTLE_MAX_PER_WINDOW=10
TAKEPLACE_VK_WORKER_HEARTBEAT_SECONDS=20
