{
  "components": {
    "schemas": {
      "AdminSummary": {
        "description": "The authenticated admin account. Never contains the password hash.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "login": {
            "title": "Login",
            "type": "string"
          }
        },
        "required": [
          "id",
          "login",
          "is_active"
        ],
        "title": "AdminSummary",
        "type": "object"
      },
      "BusinessDayResponse": {
        "description": "Computed schedule state for one business date (PROJECT-SPEC §5.1, §5.6).",
        "properties": {
          "business_date": {
            "format": "date",
            "title": "Business Date",
            "type": "string"
          },
          "current_business_date": {
            "format": "date",
            "title": "Current Business Date",
            "type": "string"
          },
          "is_open": {
            "title": "Is Open",
            "type": "boolean"
          },
          "is_open_now": {
            "title": "Is Open Now",
            "type": "boolean"
          },
          "shift_end": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shift End"
          },
          "shift_start": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shift Start"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "business_date",
          "timezone",
          "is_open",
          "is_open_now",
          "current_business_date",
          "shift_start",
          "shift_end"
        ],
        "title": "BusinessDayResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "login": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/AdminSummary"
          },
          "venue": {
            "$ref": "#/components/schemas/VenueSummary"
          }
        },
        "required": [
          "admin",
          "venue"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "OpsResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "outbox_unacknowledged_dead": {
            "default": 0,
            "title": "Outbox Unacknowledged Dead",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "timezone_capability": {
            "default": "ok",
            "enum": [
              "ok",
              "unsupported"
            ],
            "title": "Timezone Capability",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "environment"
        ],
        "title": "OpsResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ScheduleDay": {
        "description": "One weekday rule. ``is_open=false`` means the day is closed.",
        "properties": {
          "close_time": {
            "anyOf": [
              {
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Time"
          },
          "is_open": {
            "title": "Is Open",
            "type": "boolean"
          },
          "open_time": {
            "anyOf": [
              {
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Time"
          },
          "weekday": {
            "maximum": 6.0,
            "minimum": 0.0,
            "title": "Weekday",
            "type": "integer"
          }
        },
        "required": [
          "weekday",
          "is_open"
        ],
        "title": "ScheduleDay",
        "type": "object"
      },
      "ScheduleExceptionEntry": {
        "properties": {
          "close_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Time"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "is_closed": {
            "title": "Is Closed",
            "type": "boolean"
          },
          "open_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Time"
          }
        },
        "required": [
          "date",
          "is_closed",
          "open_time",
          "close_time"
        ],
        "title": "ScheduleExceptionEntry",
        "type": "object"
      },
      "ScheduleExceptionUpdate": {
        "description": "A date-specific override; it fully replaces the weekly rule (§5.3).",
        "properties": {
          "close_time": {
            "anyOf": [
              {
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close Time"
          },
          "is_closed": {
            "title": "Is Closed",
            "type": "boolean"
          },
          "open_time": {
            "anyOf": [
              {
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open Time"
          }
        },
        "required": [
          "is_closed"
        ],
        "title": "ScheduleExceptionUpdate",
        "type": "object"
      },
      "ScheduleExceptionsResponse": {
        "properties": {
          "exceptions": {
            "items": {
              "$ref": "#/components/schemas/ScheduleExceptionEntry"
            },
            "title": "Exceptions",
            "type": "array"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "timezone",
          "exceptions"
        ],
        "title": "ScheduleExceptionsResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "description": "Editable venue settings.\n\n``slug``, ``timezone`` and ``is_active`` are intentionally absent: slug and\ntimezone are not runtime-editable in v1, and suspension is a CLI operation.",
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "online_booking_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Online Booking Enabled"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 50,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "title": "SettingsUpdate",
        "type": "object"
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VenueSummary": {
        "description": "Public identity of the tenant the session belongs to.",
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "online_booking_enabled": {
            "title": "Online Booking Enabled",
            "type": "boolean"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "address",
          "phone",
          "timezone",
          "is_active",
          "online_booking_enabled"
        ],
        "title": "VenueSummary",
        "type": "object"
      },
      "WeeklyScheduleResponse": {
        "properties": {
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "weekdays": {
            "items": {
              "$ref": "#/components/schemas/ScheduleDay"
            },
            "title": "Weekdays",
            "type": "array"
          }
        },
        "required": [
          "timezone",
          "weekdays"
        ],
        "title": "WeeklyScheduleResponse",
        "type": "object"
      },
      "WeeklyScheduleUpdate": {
        "description": "Full replacement of the weekly schedule (all seven weekdays).",
        "properties": {
          "weekdays": {
            "items": {
              "$ref": "#/components/schemas/ScheduleDay"
            },
            "maxItems": 7,
            "minItems": 1,
            "title": "Weekdays",
            "type": "array"
          }
        },
        "required": [
          "weekdays"
        ],
        "title": "WeeklyScheduleUpdate",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "\nTakeplace HTTP API.\n\n* Public booking API: `/api/public/v1`\n* Admin API: `/api/admin/v1`\n* Health: `/health/live`, `/health/ready`, `/health/ops`\n\nThis OpenAPI document is the single source of API transport types for the\nfrontend. Types are generated with `openapi-typescript` and never edited by hand.\n",
    "title": "Takeplace API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/v1/auth/login": {
      "post": {
        "description": "Authenticate and start a server-side session.\n\nWrong login and wrong password return the same response (§39.5). Two cheap\nrate limits run before the CPU-bound Argon2id verify so the bounded pool\ncannot be saturated by garbage logins.",
        "operationId": "login_api_admin_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/admin/v1/auth/logout": {
      "post": {
        "description": "Revoke the current session and clear the cookie.",
        "operationId": "logout_api_admin_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/admin/v1/auth/logout-all": {
      "post": {
        "description": "Revoke every session of this venue, including the current one.",
        "operationId": "logout_all_api_admin_v1_auth_logout_all_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Logout All",
        "tags": [
          "admin-auth"
        ]
      }
    },
    "/api/admin/v1/me": {
      "get": {
        "description": "Return the authenticated admin and its venue.\n\nThe venue is derived from the session, never from a client-supplied id.",
        "operationId": "me_api_admin_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "admin-account"
        ]
      }
    },
    "/api/admin/v1/schedule": {
      "get": {
        "description": "Return this venue's weekly schedule (all seven weekdays).",
        "operationId": "get_weekly_schedule_api_admin_v1_schedule_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyScheduleResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Weekly Schedule",
        "tags": [
          "admin-schedule"
        ]
      },
      "put": {
        "description": "Replace the weekly schedule, validating grid rules and adjacent overlaps.\n\nThe request must define every weekday; a shift that crosses midnight is\nexpressed as ``close_time < open_time`` (§5.2). A schedule whose adjacent\nshifts would overlap is rejected with ``SCHEDULE_OVERLAP`` (§5.4).",
        "operationId": "put_weekly_schedule_api_admin_v1_schedule_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeeklyScheduleUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyScheduleResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Weekly Schedule",
        "tags": [
          "admin-schedule"
        ]
      }
    },
    "/api/admin/v1/schedule/business-day": {
      "get": {
        "description": "Return the computed state for a business date (§5.1, §5.6).\n\nWith no ``business_date`` the *current* business date is used — which may be\nyesterday's date while an overnight shift is still running.",
        "operationId": "get_business_day_api_admin_v1_schedule_business_day_get",
        "parameters": [
          {
            "in": "query",
            "name": "business_date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Business Date"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessDayResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Business Day",
        "tags": [
          "admin-schedule"
        ]
      }
    },
    "/api/admin/v1/schedule/exceptions": {
      "get": {
        "description": "Return this venue's date-specific schedule exceptions.",
        "operationId": "get_exceptions_api_admin_v1_schedule_exceptions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleExceptionsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Exceptions",
        "tags": [
          "admin-schedule"
        ]
      }
    },
    "/api/admin/v1/schedule/exceptions/{business_date}": {
      "delete": {
        "description": "Delete the exception for one date, reverting to the weekly rule (§5.3).",
        "operationId": "remove_exception_api_admin_v1_schedule_exceptions__business_date__delete",
        "parameters": [
          {
            "in": "path",
            "name": "business_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Business Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove Exception",
        "tags": [
          "admin-schedule"
        ]
      },
      "put": {
        "description": "Create or replace the exception for one business date (§5.3).",
        "operationId": "put_exception_api_admin_v1_schedule_exceptions__business_date__put",
        "parameters": [
          {
            "in": "path",
            "name": "business_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Business Date",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleExceptionUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleExceptionEntry"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Exception",
        "tags": [
          "admin-schedule"
        ]
      }
    },
    "/api/admin/v1/settings": {
      "get": {
        "description": "Return this venue's settings.",
        "operationId": "get_settings_api_admin_v1_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueSummary"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Settings",
        "tags": [
          "admin-settings"
        ]
      },
      "patch": {
        "description": "Update this venue's editable settings.\n\nOnly fields the client sent are applied (PATCH semantics); an unknown field\nsuch as ``venue_id`` is dropped by the schema and can never retarget the\nmutation (PROJECT-SPEC §7.1).",
        "operationId": "patch_settings_api_admin_v1_settings_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VenueSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Patch Settings",
        "tags": [
          "admin-settings"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Process liveness: no dependency checks.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ops": {
      "get": {
        "description": "Operational health for external monitoring.\n\nAlways returns 200 so monitoring can distinguish \"degraded\" from \"down\".",
        "operationId": "ops_health_ops_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
