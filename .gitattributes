# =============================================================================
# Line-ending and shell-script portability.
#
# Shell scripts executed inside Linux containers (Docker entrypoints, postgres
# init scripts) must keep LF endings even when checked out on Windows.
# =============================================================================

* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf

# Binary-ish artifacts that must never be normalized.
*.png binary
*.jpg binary
*.gif binary
*.woff binary
*.woff2 binary
