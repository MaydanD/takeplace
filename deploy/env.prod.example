# =============================================================================
# Takeplace — production / closed test-stand environment template.
#
# This is the shape of the file that must exist as `.env` next to
# `docker-compose.prod.yml` on the server (mode 600, NEVER committed).
#
#   bash deploy/scripts/bootstrap-prod-env.sh --domain <host> [--path <file>]
#
# generates a real `.env` with fresh random secrets and the correct values for a
# closed test stand. Do not hand-copy this file into place without replacing
# every placeholder: production validation rejects placeholder and short secrets
# at startup (app/settings.py).
#
# The CORS origin and the site domain must match exactly: the same value is used
# for the browser Origin check (CSRF) and for the Caddy site address.
# =============================================================================

# --- Deployment --------------------------------------------------------------
# Must be `production`: it enables the __Host- Secure session cookie, HSTS, JSON
# logs, hides /docs, and turns on the fail-fast configuration checks.
TAKEPLACE_ENV=production
TAKEPLACE_LOG_LEVEL=INFO

# --- Database (isolated logical database in the SHARED PostgreSQL) -----------
# `postgres` resolves to the `data` project's PostgreSQL on the external `data`
# network. Nothing about smm_planner / control is referenced here.
TAKEPLACE_DB_HOST=postgres
TAKEPLACE_DB_PORT=5432
TAKEPLACE_DB_NAME=takeplace
TAKEPLACE_DB_APP_USER=takeplace_app
TAKEPLACE_DB_APP_PASSWORD=<generated>
TAKEPLACE_DB_MIGRATOR_USER=takeplace_migrator
TAKEPLACE_DB_MIGRATOR_PASSWORD=<generated>

# Small pools: the shared PostgreSQL runs with max_connections=30 and already
# serves two other applications. api = pool+overflow = 5, worker = 3.
TAKEPLACE_DB_POOL_SIZE=3
TAKEPLACE_DB_MAX_OVERFLOW=2

# --- Reverse proxy trust (PROJECT-SPEC §39.5) --------------------------------
# EXACTLY the Caddy container's address on the `edge` network. No subnet, no
# wildcard. Re-check with deploy/scripts/check-proxy-ip.sh after any recreation
# of the infra Caddy container.
TAKEPLACE_FORWARDED_ALLOW_IPS=<caddy-edge-ip>

# --- CORS / CSRF origin ------------------------------------------------------
# Exact HTTPS origin of the deployed site. Never "*".
TAKEPLACE_CORS_ORIGINS=https://<domain>

# --- Secrets (generated) -----------------------------------------------------
TAKEPLACE_IDEMPOTENCY_HMAC_KEY=<generated>
TAKEPLACE_ABUSE_HMAC_KEY=<generated>
TAKEPLACE_VK_ENCRYPTION_KEYS=1:<generated base64url 32 bytes>

# --- Sessions ----------------------------------------------------------------
TAKEPLACE_SESSION_TTL_DAYS=30
TAKEPLACE_ARGON2_MAX_CONCURRENCY=2

# --- VK delivery -------------------------------------------------------------
# Disabled: no valid VK community token/destination exists for this test stand,
# and none is invented (PROJECT-SPEC §38). Disabling delivery does NOT stop the
# independent retention/anonymization maintenance loop (§42.2).
TAKEPLACE_VK_WORKER_ENABLED=false

# --- Privacy / retention -----------------------------------------------------
TAKEPLACE_BOOKING_PII_RETENTION_DAYS=90
TAKEPLACE_OUTBOX_RETENTION_DAYS=30
TAKEPLACE_MAINTENANCE_INTERVAL_SECONDS=3600

# --- Public booking ----------------------------------------------------------
# Kept disabled on the venue itself (online_booking_enabled=false) until the
# owner explicitly enables it (PROJECT-SPEC §6.1).
TAKEPLACE_PUBLIC_CAPTCHA_ENABLED=false

# --- Deployment identity -----------------------------------------------------
# Image tag for the built backend/frontend images. Used for update + rollback.
TAKEPLACE_IMAGE_TAG=local
